{
  "name": "@sep1ol/teamclaude",
  "version": "1.2.0-team.1",
  "description": "Self-hosted team gateway for Claude Code and Codex with individual credentials, account grants, and concurrency limits",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "teamclaude": "src/index.js",
    "teamrouter": "src/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-timeout=120000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:strict": "node scripts/typecheck-strict.mjs"
  },
  "keywords": [
    "claude",
    "anthropic",
    "claude-code",
    "codex",
    "openai",
    "chatgpt",
    "deepseek",
    "proxy",
    "load-balancer",
    "multi-account",
    "quota",
    "rate-limiting",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sep1ol/relaycrew.git"
  },
  "bugs": {
    "url": "https://github.com/sep1ol/relaycrew/issues"
  },
  "homepage": "https://github.com/sep1ol/relaycrew#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "eslint": "^9.0.0",
    "typescript": "5.9.2"
  }
}
